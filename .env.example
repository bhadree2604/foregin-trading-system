# Foreign Trading System — Environment Template
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# MySQL Database (sole database)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD="anime@#26"
MYSQL_DATABASE=foreign_trading_system

# Auth — JWT session signing key (set a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Stripe Configuration (server-side publishable key for checkout UI)
# Get from Stripe Dashboard > Developers > API keys (use TEST keys for development)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# App Configuration
APP_NAME=Foreign Trading System
APP_URL=http://localhost:3000

# Market Data - Twelve Data API (SERVER-SIDE ONLY)
TWELVE_DATA_API_KEY=your_twelve_data_key_here

# Payment webhook HMAC secret (server-side only)
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here

# NOTE: Stripe Secret Key and Webhook Secret must NEVER be exposed as
# NEXT_PUBLIC_ variables. Keep them server-side only (.env.local, not committed).
